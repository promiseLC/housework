# Local development only; create a local DB user and replace placeholders.
DATABASE_URL=mysql+pymysql://LOCAL_USER:LOCAL_PASSWORD@127.0.0.1:3306/household_pay?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://LOCAL_USER:LOCAL_PASSWORD@127.0.0.1:3306/household_pay_test?charset=utf8mb4
# Generate locally: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_LOCAL_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
